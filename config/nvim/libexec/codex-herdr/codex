#!/usr/bin/env bash
set -u

real_codex="${CODEX_REAL_BIN:-}"
herdr_bin="${CODEX_HERDR_BIN:-herdr}"
pane_id="${HERDR_PANE_ID:-}"
route_file="${CODEX_NVIM_STATE_FILE:-}"
cleanup_done=0

# ShellCheck does not follow function references installed through trap.
# shellcheck disable=SC2329
cleanup() {
	if [ "${cleanup_done}" -eq 1 ]; then
		return
	fi
	cleanup_done=1

	if [ -n "${route_file}" ]; then
		rm -f -- "${route_file}"
	fi
	if [ -n "${pane_id}" ]; then
		"${herdr_bin}" pane close "${pane_id}" >/dev/null 2>&1 || true
	fi
}

trap cleanup EXIT

if [ -z "${real_codex}" ]; then
	printf 'codex-herdr: CODEX_REAL_BIN is not set\n' >&2
	exit 127
fi

"${real_codex}" "$@"
exit $?
