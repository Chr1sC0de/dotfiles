#!/usr/bin/env bash
set -u

# This filename must stay backend-neutral. An OpenCode-named parent shell makes
# Herdr classify Pi's foreground process group as OpenCode.
real_agent="${AGENT_REAL_BIN:-}"
herdr_bin="${OPENCODE_HERDR_BIN:-herdr}"
pane_id="${HERDR_PANE_ID:-}"
route_file="${OPENCODE_NVIM_STATE_FILE:-}"
cleanup_done=0

# ShellCheck does not follow function references installed through trap.
# shellcheck disable=SC2329,SC2317
cleanup() {
	if [ "${cleanup_done}" -eq 1 ]; then return; fi
	cleanup_done=1
	if [ -n "${route_file}" ]; then
		rm -f -- "${route_file}" "${route_file}.launch.json"
	fi
	if [ -n "${pane_id}" ]; then
		"${herdr_bin}" pane close "${pane_id}" >/dev/null 2>&1 || true
	fi
}

trap cleanup EXIT
if [ -z "${real_agent}" ]; then
	printf 'agent-herdr: AGENT_REAL_BIN is not set\n' >&2
	exit 127
fi

"${real_agent}" "$@"
exit $?
