{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "$HOME/.config/nvim/bin/opencode-mux-status-hook working"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "$HOME/.config/nvim/bin/opencode-mux-status-hook working"
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "$HOME/.config/nvim/bin/opencode-mux-status-hook done"
      }
    ]
  }
}
